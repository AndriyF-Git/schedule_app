# --- Flask ---
SECRET_KEY=your_super_secret_key_here
ADMIN_PIN=1234

# --- Database ---
# Development (default):
DATABASE_URL=sqlite:///schedule.db

# Testing with seeded data (run seed_data.py after switching):
# DATABASE_URL=sqlite:///test.db

# In-memory (pytest uses this automatically via conftest — no need to set here):
# DATABASE_URL=sqlite:///:memory:

# --- Flask-Migrate workflow ---
# New database from scratch:      flask db upgrade
# After changing models in app.py: flask db migrate -m "description"
#                                   flask db upgrade
# Check current revision:          flask db current
